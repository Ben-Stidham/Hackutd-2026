[Unit]
Description=Error Detection Process Exit Monitor Daemon
After=network.target graphical.target

[Service]
Type=simple
ExecStart=/usr/local/bin/error_detection run --pid-file /run/error_detection.pid --log-file /var/log/error_detection.log
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN CAP_SETUID CAP_SETGID
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
