[Unit]
Description=Error Detection Process Exit Monitor Daemon
After=network.target graphical.target

[Service]
Type=simple
ExecStart=/usr/local/bin/error_detection run --pid-file /run/error_detection.pid --log-file /var/log/error_detection.log --db-file /tmp/error_detection.db --port 8032
Restart=on-failure
RestartSec=3
PrivateTmp=false
AmbientCapabilities=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
